# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust / Tauri build artifacts
# Bare pattern: matches at any depth, so spike Rust builds are covered too.
target/
src-tauri/gen/schemas

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets — previously only sidecar/.gitignore covered .env.
# v2.0 P2 adds real secrets plumbing (sops-nix + systemd LoadCredential).
.env
.env.*
!.env.example

# Per-machine Claude Code settings
.claude/settings.local.json

# Large downloaded images (spike 010's nixos.wsl was protected only by
# happening to live under dist/)
*.wsl
*.vhdx

# Nix build outputs / direnv state
# `result`/`result-*` are per-machine symlinks into /nix/store; .direnv/ is a local cache.
result
result-*
.direnv/
.planning/research/.cache/

# VS Code exploration clone (own git repo, 338MB) — moves under Sourcerer-v0/ in v3.0 Phase 1
VSC Sourcerer Alternitive Exploration/
